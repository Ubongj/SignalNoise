# Copy to .env.local. NEXT_PUBLIC_* vars are exposed to the browser.

# WalletConnect Cloud projectId (free: https://cloud.walletconnect.com).
# Injected wallets (MetaMask) work without it; WalletConnect/mobile needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# SignalVsNoise contract address on Arbitrum Sepolia (set after deploy).
NEXT_PUBLIC_SIGNAL_VS_NOISE_ADDRESS=
